{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HotpotQA native retrieval add-on v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "split",
    "scenario",
    "query",
    "local_context",
    "memory",
    "labels",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "split": {
      "const": "dev"
    },
    "scenario": {
      "enum": [
        "hotpotqa_bridge",
        "hotpotqa_comparison"
      ]
    },
    "query": {
      "type": "string"
    },
    "local_context": {
      "const": ""
    },
    "memory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text",
          "sentences",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "sentences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "const": "wikipedia"
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "answerable",
        "retrieval_required",
        "acceptable_evidence_sets",
        "supporting_facts",
        "question_type",
        "difficulty"
      ],
      "properties": {
        "answer": {
          "type": "string"
        },
        "answerable": {
          "const": true
        },
        "retrieval_required": {
          "const": true
        },
        "acceptable_evidence_sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "supporting_facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "title",
              "sentence_index"
            ],
            "properties": {
              "document_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "sentence_index": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "question_type": {
          "enum": [
            "bridge",
            "comparison"
          ]
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "upstream_split",
        "source_id",
        "source_index",
        "source_url",
        "license",
        "adaptation_version"
      ],
      "properties": {
        "dataset": {
          "const": "HotpotQA"
        },
        "upstream_split": {
          "const": "dev_distractor"
        },
        "source_id": {
          "type": "string"
        },
        "source_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_url": {
          "const": "https://huggingface.co/datasets/namlh2004/hotpotqa/resolve/7e54db4656209750ff487f6fdf8e39a66dba136b/hotpot_dev_distractor_v1.json"
        },
        "license": {
          "const": "https://creativecommons.org/licenses/by-sa/4.0/"
        },
        "adaptation_version": {
          "const": "1.0"
        }
      }
    }
  }
}
